{% extends 'base.html.twig' %}

{% block title %}Assignments | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container">
    <div class="page-header">
        <div>
            <h1>My Assignments</h1>
            <p>Track assignment deadlines, priorities, and completion progress.</p>
        </div>

        <a href="{{ path('app_assignment_new') }}" class="btn btn-primary-yellow">Add Assignment</a>
    </div>

    <div class="card">
        {% if assignments is empty %}
            <div class="empty-state centered">
                <p>No assignments added yet.</p>
                <a href="{{ path('app_assignment_new') }}" class="btn">Create your first assignment</a>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Course</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Risk</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for assignment in assignments %}
                        <tr>
                            <td><strong>{{ assignment.title }}</strong></td>
                            <td>
                                {{ assignment.course.name }}
                                {% if assignment.course.code %}
                                    <br><small>{{ assignment.course.code }}</small>
                                {% endif %}
                            </td>
                            <td>{{ assignment.deadline ? assignment.deadline|date('d M Y, H:i') : 'N/A' }}</td>
                            <td>
                                <span class="badge badge-{{ assignment.status }}">
                                    {{ assignment.status|replace({'_': ' '}) }}
                                </span>
                            </td>
                            <td>
                                {% if assignment.priority %}
                                    <span class="badge badge-{{ assignment.priority }}">
                                        {{ assignment.priority }}
                                    </span>
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                {% set prediction = predictionsByAssignmentId[assignment.id]|default(null) %}

                                {% if prediction %}
                                    <span class="badge badge-{{ prediction.riskLevel }}">
                                        {{ prediction.riskLevel }}
                                    </span>
                                    {% if prediction.probability is not null %}
                                        <br><small>{{ (prediction.probability * 100)|round }}%</small>
                                    {% endif %}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>

                            <td>
                                <div class="actions">
                                    <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="action-btn action-view">View</a>
                                    <a href="{{ path('app_assignment_edit', {'id': assignment.id}) }}" class="action-btn action-edit">Edit</a>

                                    {% if assignment.status == 'pending' %}
                                        <form method="post" action="{{ path('app_assignment_start', {'id': assignment.id}) }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('start' ~ assignment.id) }}">
                                            <button type="submit" class="action-btn start-btn">Start</button>
                                        </form>
                                    {% elseif assignment.status == 'in_progress' %}
                                        <form method="post" action="{{ path('app_assignment_complete', {'id': assignment.id}) }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ assignment.id) }}">
                                            <button type="submit" class="action-btn complete-btn">Complete</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
