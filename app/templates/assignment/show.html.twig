{% extends 'base.html.twig' %}

{% block title %}Assignment Details | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .page-container {
        max-width: 820px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 24px;
    }

    .page-header h1 {
        margin: 0;
        color: #111827;
        font-size: 30px;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #6b7280;
        line-height: 1.5;
    }

    .card {
        background: #ffffff;
        padding: 32px;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #6b7280;
        font-weight: bold;
        font-size: 14px;
    }

    .detail-value {
        color: #111827;
        font-size: 15px;
        text-align: right;
        max-width: 520px;
    }

    .badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: bold;
        text-transform: capitalize;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-completed {
        background: #dcfce7;
        color: #166534;
    }

    .badge-high {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-medium {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-low {
        background: #e5e7eb;
        color: #374151;
    }

    .page-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-top: 22px;
    }

    .left-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #ffffff;
        padding: 11px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .btn:hover {
        background: #1d4ed8;
    }

    .btn-success {
        background: #16a34a;
        border: none;
        cursor: pointer;
    }

    .btn-success:hover {
        background: #15803d;
    }
    .btn-secondary {
        background: #374151;
    }

    .btn-secondary:hover {
        background: #1f2937;
    }

    @media (max-width: 640px) {
        .detail-row {
            flex-direction: column;
            gap: 6px;
        }

        .detail-value {
            text-align: left;
        }

        .page-actions,
        .left-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Assignment Details</h1>
        <p>View assignment deadline information, course link, priority, and completion status.</p>
    </div>

    <div class="card">
        <div class="detail-row">
            <div class="detail-label">Title</div>
            <div class="detail-value">{{ assignment.title }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Description</div>
            <div class="detail-value">{{ assignment.description ?: 'N/A' }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Course</div>
            <div class="detail-value">
                {{ assignment.course.name }}
                {% if assignment.course.code %}
                    ({{ assignment.course.code }})
                {% endif %}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Deadline</div>
            <div class="detail-value">{{ assignment.deadline ? assignment.deadline|date('d M Y, H:i') : 'N/A' }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Status</div>
            <div class="detail-value">
                <span class="badge badge-{{ assignment.status }}">
                    {{ assignment.status }}
                </span>
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Priority</div>
            <div class="detail-value">
                {% if assignment.priority %}
                    <span class="badge badge-{{ assignment.priority }}">
                        {{ assignment.priority }}
                    </span>
                {% else %}
                    N/A
                {% endif %}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Completed At</div>
            <div class="detail-value">{{ assignment.completedAt ? assignment.completedAt|date('d M Y, H:i') : 'Not completed yet' }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Date Added</div>
            <div class="detail-value">{{ assignment.createdAt ? assignment.createdAt|date('d M Y, H:i') : 'N/A' }}</div>
        </div>
    </div>

    <div class="page-actions">
        <div class="left-actions">
            <a href="{{ path('app_assignment_index') }}" class="btn btn-secondary">Back to Assignments</a>

            {% if assignment.status != 'completed' %}
                <form method="post" action="{{ path('app_assignment_complete', {'id': assignment.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ assignment.id) }}">
                    <button class="btn btn-success" type="submit">Mark Completed</button>
                </form>
            {% endif %}

            <a href="{{ path('app_assignment_edit', {'id': assignment.id}) }}" class="btn">Edit Assignment</a>
        </div>
        {{ include('assignment/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}