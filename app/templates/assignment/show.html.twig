{% extends 'base.html.twig' %}

{% block title %}Assignment Details | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container page-container-narrow">
    <div class="page-header">
        <div>
            <h1>Assignment Details</h1>
            <p>View assignment deadline information, course link, priority, and completion status.</p>
        </div>
    </div>

    <div class="card">
        <div class="detail-row">
            <div class="detail-label">Title</div>
            <div class="detail-value">{{ assignment.title }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Description</div>
            <div class="detail-value">{{ assignment.description ?: 'N/A' }}</div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Course</div>
            <div class="detail-value">
                {{ assignment.course.name }}
                {% if assignment.course.code %}
                    ({{ assignment.course.code }})
                {% endif %}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Deadline</div>
            <div class="detail-value">
                {{ assignment.deadline ? assignment.deadline|date('d M Y, h:i A') : 'N/A' }}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Status</div>
            <div class="detail-value">
                <span class="badge badge-{{ assignment.status }}">
                    {{ assignment.status|replace({'_': ' '}) }}
                </span>
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Priority</div>
            <div class="detail-value">
                {% if assignment.priority %}
                    <span class="badge badge-{{ assignment.priority }}">
                        {{ assignment.priority }}
                    </span>
                {% else %}
                    N/A
                {% endif %}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">AI Risk Prediction</div>
            <div class="detail-value">
                {% if prediction %}
                    <span class="badge badge-{{ prediction.riskLevel }}">
                        {{ prediction.riskLevel }}
                    </span>

                    {% if prediction.probability is not null %}
                        <br>
                        <small>Confidence: {{ (prediction.probability * 100)|round }}%</small>
                    {% endif %}

                    {% if prediction.modelName %}
                        <br>
                        <small>Model: {{ prediction.modelName|replace({'_': ' '}) }}</small>
                    {% endif %}
                {% else %}
                    N/A
                {% endif %}
            </div>
        </div>
        
        <div class="detail-row">
            <div class="detail-label">Completed At</div>
            <div class="detail-value">
                {{ assignment.completedAt ? assignment.completedAt|date('d M Y, h:i A') : 'Not completed yet' }}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Date Added</div>
            <div class="detail-value">
                {{ assignment.createdAt ? assignment.createdAt|date('d M Y, h:i A') : 'N/A' }}
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Last Updated</div>
            <div class="detail-value">
                {{ assignment.updatedAt ? assignment.updatedAt|date('d M Y, h:i A') : 'N/A' }}
            </div>
        </div>
    </div>

    <div class="page-actions">
        <div class="left-actions">
            <a href="{{ path('app_assignment_index') }}" class="btn btn-secondary">Back to Assignments</a>

            {% if assignment.status == 'pending' %}
                <form method="post" action="{{ path('app_assignment_start', {'id': assignment.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('start' ~ assignment.id) }}">
                    <button class="btn btn-start" type="submit">Start Assignment</button>
                </form>
            {% elseif assignment.status == 'in_progress' %}
                <form method="post" action="{{ path('app_assignment_complete', {'id': assignment.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ assignment.id) }}">
                    <button class="btn btn-success" type="submit">Mark Completed</button>
                </form>
            {% endif %}

            {% if assignment.status == 'completed' %}
                <span class="btn btn-disabled" title="Completed assignments are view-only">Completed - view only</span>
            {% else %}
                <a href="{{ path('app_assignment_edit', {'id': assignment.id}) }}" class="btn btn-primary-yellow">Edit Assignment</a>
            {% endif %}
        </div>

        {{ include('assignment/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
