{% set modalId = 'deleteAssignmentModal' ~ assignment.id %}

<button type="button"
        class="delete-trigger"
        onclick="document.getElementById('{{ modalId }}').classList.add('active')">
    Delete Assignment
</button>

<div class="modal-backdrop" id="{{ modalId }}">
    <div class="modal-card">
        <h3>Delete assignment?</h3>

        <p>
            You are about to delete <strong>{{ assignment.title }}</strong>.
            This action cannot be undone.
        </p>

        <div class="modal-actions">
            <button type="button"
                    class="modal-cancel"
                    onclick="document.getElementById('{{ modalId }}').classList.remove('active')">
                Cancel
            </button>

            <form method="post" action="{{ path('app_assignment_delete', {'id': assignment.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                <button class="modal-delete">Yes, delete</button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('{{ modalId }}');

        if (!modal) {
            return;
        }

        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                modal.classList.remove('active');
            }
        });
    })();
</script>
