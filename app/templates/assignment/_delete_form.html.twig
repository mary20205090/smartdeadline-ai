{% set modalId = 'deleteAssignmentModal' ~ assignment.id %}

<button type="button"
        class="delete-trigger"
        onclick="document.getElementById('{{ modalId }}').classList.add('active')">
    Remove Assignment
</button>

<div class="modal-backdrop" id="{{ modalId }}">
    <div class="modal-card modal-danger">
        <div class="modal-icon">!</div>
        <h3>Remove assignment?</h3>

        <p>
            This will remove <strong>{{ assignment.title }}</strong> from your account.
            You cannot recover it from the app once removed.
        </p>

        <div class="modal-actions">
            <button type="button"
                    class="modal-cancel"
                    onclick="document.getElementById('{{ modalId }}').classList.remove('active')">
                Cancel
            </button>

            <form method="post" action="{{ path('app_assignment_delete', {'id': assignment.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                <button class="modal-delete">Yes, remove</button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('{{ modalId }}');

        if (!modal) {
            return;
        }

        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                modal.classList.remove('active');
            }
        });
    })();
</script>
