{% extends 'base.html.twig' %}

{% block title %}Edit Assignment | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body { margin: 0; background: #f4f7fb; font-family: Arial, sans-serif; }

    .page-container { max-width: 760px; margin: 50px auto; padding: 0 20px; }

    .page-header { margin-bottom: 24px; }
    .page-header h1 { margin: 0; color: #111827; font-size: 30px; }
    .page-header p { margin: 8px 0 0; color: #6b7280; line-height: 1.5; }

    .card {
        background: #ffffff; padding: 32px; border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    }

    .page-actions {
        display: flex; justify-content: space-between; align-items: center;
        gap: 14px; margin-top: 20px;
    }

    .back-link {
        color: #2563eb; text-decoration: none; font-weight: bold;
    }

    .back-link:hover { text-decoration: underline; }

    @media (max-width: 640px) {
        .page-actions { flex-direction: column; align-items: stretch; }
        .back-link { text-align: center; }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1>Edit Assignment</h1>
        <p>Update the assignment deadline, priority, course, or description.</p>
    </div>

    <div class="card">
        {{ include('assignment/_form.html.twig', {'button_label': 'Update Assignment'}) }}
    </div>

    <div class="page-actions">
        <a href="{{ path('app_assignment_index') }}" class="back-link">← Back to assignments</a>
        <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="back-link">View details →</a>
    </div>
</div>
{% endblock %}