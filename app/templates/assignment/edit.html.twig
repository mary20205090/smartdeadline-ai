{% extends 'base.html.twig' %}

{% block title %}Edit Assignment | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container page-container-narrow">
    <div class="page-header">
        <div>
            <h1>Edit Assignment</h1>
            <p>Update the assignment deadline, priority, course, or description.</p>
        </div>
    </div>

    <div class="card">
        <div class="edit-context">
            <div>
                <span>Currently editing</span>
                <strong>{{ assignment.title }}</strong>
            </div>
            <div>
                <span>Course to save</span>
                <strong data-selected-course-preview>
                    {{ assignment.course.name }}
                    {% if assignment.course.code %}
                        ({{ assignment.course.code }})
                    {% endif %}
                </strong>
            </div>
        </div>

        {{ include('assignment/_form.html.twig', {'button_label': 'Update Assignment'}) }}
    </div>

    <div class="page-actions">
        <a href="{{ path('app_assignment_index') }}" class="back-link">Back to assignments</a>
        <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="back-link">View details</a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const courseSelect = document.getElementById('{{ form.course.vars.id }}');
        const coursePreview = document.querySelector('[data-selected-course-preview]');

        if (!courseSelect || !coursePreview) {
            return;
        }

        courseSelect.addEventListener('change', function () {
            const selectedOption = courseSelect.options[courseSelect.selectedIndex];
            coursePreview.textContent = selectedOption && selectedOption.value ? selectedOption.text : 'Select course';
        });
    });
</script>
{% endblock %}
