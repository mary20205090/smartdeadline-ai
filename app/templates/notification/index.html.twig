{% extends 'base.html.twig' %}

{% block title %}Notifications | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Notifications</h1>
            <p>View deadline alerts for assignments that are due soon or overdue.</p>
        </div>

        <div class="top-actions">
            {% if notifications is not empty %}
                <form method="post" action="{{ path('app_notification_read_all') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifications') }}">
                    <button type="submit" class="btn btn-primary-yellow">Mark All Read</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        {% if notifications is empty %}
            <div class="empty-state centered">
                No notifications yet. Deadline alerts will appear here when assignments are due soon or overdue.
            </div>
        {% else %}
            <ul class="notification-list">
                {% for notification in notifications %}
                    <li class="notification-item">
                        <div>
                            <div class="notification-title">{{ notification.title }}</div>
                            <div class="notification-message">{{ notification.message }}</div>
                            <div class="notification-time">
                                {{ notification.createdAt ? notification.createdAt|date('d M Y, H:i') : '' }}
                            </div>
                        </div>

                        <div class="notification-actions">
                            <span class="status-badge status-{{ notification.status }}">
                                {{ notification.status }}
                            </span>

                            {% if notification.assignment %}
                                <a href="{{ path('app_assignment_show', {'id': notification.assignment.id}) }}" class="btn btn-light">
                                    View Assignment
                                </a>
                            {% endif %}

                            {% if notification.status == 'unread' %}
                                <form method="post" action="{{ path('app_notification_read', {'id': notification.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read' ~ notification.id) }}">
                                    <button type="submit" class="btn btn-secondary">Mark Read</button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
