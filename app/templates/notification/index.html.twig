{% extends 'base.html.twig' %}

{% block title %}Notifications | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .page-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-header h1 {
        margin: 0;
        color: #111827;
        font-size: 30px;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #6b7280;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #ffffff;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
        border: none;
        cursor: pointer;
    }

    .btn:hover {
        background: #1d4ed8;
    }

    .btn-secondary {
        background: #374151;
    }

    .btn-secondary:hover {
        background: #1f2937;
    }

    .btn-light {
        background: #eff6ff;
        color: #2563eb;
    }

    .btn-light:hover {
        background: #dbeafe;
    }

    .card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        padding: 24px;
    }

    .notification-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .notification-item {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .notification-item:last-child {
        border-bottom: none;
    }

    .notification-title {
        font-weight: bold;
        color: #111827;
        margin-bottom: 6px;
    }

    .notification-message {
        color: #6b7280;
        line-height: 1.5;
        font-size: 14px;
    }

    .notification-time {
        color: #9ca3af;
        font-size: 13px;
        margin-top: 6px;
    }

    .notification-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-end;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: bold;
        text-transform: capitalize;
    }

    .status-unread {
        background: #fef3c7;
        color: #92400e;
    }

    .status-read {
        background: #e5e7eb;
        color: #374151;
    }

    .empty-state {
        color: #6b7280;
        text-align: center;
        padding: 40px 20px;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    form {
        margin: 0;
    }

    @media (max-width: 700px) {
        .page-header,
        .notification-item {
            flex-direction: column;
        }

        .notification-actions {
            align-items: stretch;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Notifications</h1>
            <p>View deadline alerts for assignments that are due soon or overdue.</p>
        </div>

        <div class="top-actions">
            <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Back to Dashboard</a>

            {% if notifications is not empty %}
                <form method="post" action="{{ path('app_notification_read_all') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifications') }}">
                    <button type="submit" class="btn">Mark All Read</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        {% if notifications is empty %}
            <div class="empty-state">
                No notifications yet. Deadline alerts will appear here when assignments are due soon or overdue.
            </div>
        {% else %}
            <ul class="notification-list">
                {% for notification in notifications %}
                    <li class="notification-item">
                        <div>
                            <div class="notification-title">{{ notification.title }}</div>
                            <div class="notification-message">{{ notification.message }}</div>
                            <div class="notification-time">
                                {{ notification.createdAt ? notification.createdAt|date('d M Y, H:i') : '' }}
                            </div>
                        </div>

                        <div class="notification-actions">
                            <span class="status-badge status-{{ notification.status }}">
                                {{ notification.status }}
                            </span>

                            {% if notification.assignment %}
                                <a href="{{ path('app_assignment_show', {'id': notification.assignment.id}) }}" class="btn btn-light">
                                    View Assignment
                                </a>
                            {% endif %}

                            {% if notification.status == 'unread' %}
                                <form method="post" action="{{ path('app_notification_read', {'id': notification.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read' ~ notification.id) }}">
                                    <button type="submit" class="btn btn-secondary">Mark Read</button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}