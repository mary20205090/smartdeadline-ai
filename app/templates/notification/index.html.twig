{% extends 'base.html.twig' %}

{% block title %}Notifications | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Notifications</h1>
            <p>View deadline alerts for assignments that are due soon or overdue.</p>
        </div>

        <div class="top-actions">
            <form method="get" action="{{ path('app_notification_index') }}" class="notification-filter-form">
                <label for="notification-status">Show</label>
                <select id="notification-status" name="status" onchange="this.form.submit()">
                    <option value="unread" {{ notificationFilter == 'unread' ? 'selected' : '' }}>
                        Unread ({{ unreadNotificationCount|default(0) }})
                    </option>
                    <option value="read" {{ notificationFilter == 'read' ? 'selected' : '' }}>
                        Read ({{ readNotificationCount|default(0) }})
                    </option>
                    <option value="all" {{ notificationFilter == 'all' ? 'selected' : '' }}>
                        All
                    </option>
                </select>
            </form>

            {% if unreadNotificationCount|default(0) > 0 %}
                <form method="post" action="{{ path('app_notification_read_all', {'status': notificationFilter}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifications') }}">
                    <button type="submit" class="btn btn-primary-yellow">Mark All Read</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        {% if notifications is empty %}
            <div class="empty-state centered">
                {% if notificationFilter == 'read' %}
                    No read notifications yet.
                {% elseif notificationFilter == 'all' %}
                    No notifications yet. Deadline alerts will appear here when assignments are due soon or overdue.
                {% else %}
                    No unread notifications. New deadline alerts will appear here.
                {% endif %}
            </div>
        {% else %}
            <ul class="notification-list">
                {% for notification in notifications %}
                    <li class="notification-item">
                        <div>
                            <div class="notification-title">{{ notification.title }}</div>
                            <div class="notification-message">{{ notification.message }}</div>
                            <div class="notification-time">
                                {{ notification.createdAt ? notification.createdAt|date('d M Y, H:i') : '' }}
                            </div>
                        </div>

                        <div class="notification-actions">
                            <span class="status-badge status-{{ notification.status }}">
                                {{ notification.status }}
                            </span>

                            {% if notification.assignment %}
                                <a href="{{ path('app_assignment_show', {'id': notification.assignment.id}) }}" class="btn btn-light">
                                    View Assignment
                                </a>
                            {% endif %}

                            {% if notification.status == 'unread' %}
                                <form method="post" action="{{ path('app_notification_read', {'id': notification.id, 'status': notificationFilter}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read' ~ notification.id) }}">
                                    <button type="submit" class="btn btn-secondary">Mark Read</button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
