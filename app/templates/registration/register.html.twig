{% extends 'base.html.twig' %}

{% block title %}Register | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="auth-page">
    <section class="auth-panel">
        <a href="{{ path('app_login') }}" class="auth-brand">
            <span class="app-logo">SD</span>
            <span>
                <strong>SMARTDEADLINE AI</strong>
                <small>Assignment risk prediction</small>
            </span>
        </a>

        <div class="auth-copy">
            <p class="eyebrow">Start organized</p>
            <h1>Build better deadline habits.</h1>
            <p>Create a student workspace for courses, assignments, risk signals, and reminders.</p>
        </div>

        <div class="auth-highlights">
            <span>Personal dashboard</span>
            <span>AI predictions</span>
            <span>Reminder ready</span>
        </div>
    </section>

    <div class="auth-card">
        <div class="auth-card-header">
            <p class="eyebrow">Create workspace</p>
            <h2>Create account</h2>
            <p>Join SMARTDEADLINE AI to manage your courses, track assignments, and receive deadline risk alerts.</p>
        </div>

        {{ form_start(registrationForm) }}

            <div class="form-group">
                {{ form_label(registrationForm.fullName, 'Full Name') }}
                {{ form_widget(registrationForm.fullName) }}
                {{ form_errors(registrationForm.fullName) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.email, 'Email address') }}
                {{ form_widget(registrationForm.email) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.plainPassword, 'Password') }}
                {{ form_widget(registrationForm.plainPassword) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="checkbox-row">
                {{ form_widget(registrationForm.emailNotificationsEnabled) }}
                {{ form_label(registrationForm.emailNotificationsEnabled, 'Send me email deadline reminders') }}
            </div>
            {{ form_errors(registrationForm.emailNotificationsEnabled) }}

            <div class="checkbox-row">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, 'I agree to the terms and conditions') }}
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            <button type="submit" class="btn-primary">Create account</button>

        {{ form_end(registrationForm) }}

        <div class="auth-footer">
            Already have an account?
            <a href="{{ path('app_login') }}">Sign in</a>
        </div>
    </div>
</div>
{% endblock %}
