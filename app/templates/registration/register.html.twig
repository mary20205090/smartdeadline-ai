{% extends 'base.html.twig' %}

{% block title %}Register | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="auth-page">
    <section class="auth-panel">
        <a href="{{ path('app_login') }}" class="auth-brand">
            <span class="app-logo">SD</span>
            <span>
                <strong>SMARTDEADLINE AI</strong>
                <small>Assignment risk prediction</small>
            </span>
        </a>

        <div class="auth-copy">
            <p class="eyebrow">Start organized</p>
            <h1>Build better deadline habits.</h1>
            <p>Create a student workspace for courses, assignments, risk signals, and reminders.</p>
        </div>

        <div class="auth-highlights">
            <span>Personal dashboard</span>
            <span>AI predictions</span>
            <span>Reminder ready</span>
        </div>
    </section>

    <div class="auth-card">
        <div class="auth-card-header">
            <p class="eyebrow">Create workspace</p>
            <h2>Create account</h2>
            <p>Join SMARTDEADLINE AI to manage your courses, track assignments, and receive deadline risk alerts.</p>
        </div>

            {{ form_start(registrationForm, {'attr': {'data-turbo': 'false'}}) }}

            <div class="form-group">
                {{ form_label(registrationForm.fullName, 'Full Name') }}
                {{ form_widget(registrationForm.fullName) }}
                {{ form_errors(registrationForm.fullName) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.email, 'Email address') }}
                {{ form_widget(registrationForm.email) }}
                <div class="form-help">Use a valid email address, for example mary@example.com.</div>
                <div class="form-errors" data-email-live-error style="display: none;"></div>
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.plainPassword, 'Password') }}
                {{ form_widget(registrationForm.plainPassword) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="checkbox-row">
                {{ form_widget(registrationForm.emailNotificationsEnabled) }}
                {{ form_label(registrationForm.emailNotificationsEnabled, 'Send me email deadline reminders') }}
            </div>
            {{ form_errors(registrationForm.emailNotificationsEnabled) }}

            <div class="checkbox-row">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, 'I agree to the terms and conditions') }}
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            <button type="submit" class="btn-primary">Create account</button>

        {{ form_end(registrationForm) }}

        <div class="auth-footer">
            Already have an account?
            <a href="{{ path('app_login') }}">Sign in</a>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.querySelector('[data-valid-email]');
            const emailError = document.querySelector('[data-email-live-error]');

            if (!emailInput || !emailError) {
                return;
            }

            const emailPattern = /^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;

            function validateEmailField() {
                const value = emailInput.value.trim();

                if (value === '') {
                    emailInput.setCustomValidity('Email address is required.');
                    emailError.textContent = 'Email address is required.';
                    emailError.style.display = 'block';
                    return false;
                }

                if (value.includes('..')) {
                    emailInput.setCustomValidity('Email address cannot contain consecutive dots.');
                    emailError.textContent = 'Email address cannot contain consecutive dots.';
                    emailError.style.display = 'block';
                    return false;
                }

                if (!emailPattern.test(value)) {
                    emailInput.setCustomValidity('Enter a valid email address such as mary@example.com.');
                    emailError.textContent = 'Enter a valid email address such as mary@example.com.';
                    emailError.style.display = 'block';
                    return false;
                }

                emailInput.setCustomValidity('');
                emailError.textContent = '';
                emailError.style.display = 'none';
                return true;
            }

            emailInput.addEventListener('input', validateEmailField);
            emailInput.addEventListener('blur', validateEmailField);

            emailInput.closest('form')?.addEventListener('submit', function (event) {
                if (!validateEmailField()) {
                    event.preventDefault();
                    emailInput.reportValidity();
                }
            });
        });
    </script>
{% endblock %}
