{% extends 'base.html.twig' %}

{% block title %}Edit Course | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container page-container-narrow">
    <div class="page-header">
        <div>
            <h1>Edit Course</h1>
            <p>Update the course details used for tracking assignments and deadline predictions.</p>
        </div>
    </div>

    <div class="card">
        {{ include('course/_form.html.twig', {'button_label': 'Update Course'}) }}
    </div>

    <div class="page-actions">
        <a href="{{ path('app_course_index') }}" class="back-link">Back to courses</a>

        {{ include('course/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
