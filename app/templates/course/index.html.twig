{% extends 'base.html.twig' %}

{% block title %}Courses | SMARTDEADLINE AI{% endblock %}

{% block body %}
<div class="page-container">
    <div class="page-header">
        <div>
            <h1>My Courses</h1>
            <p>Manage the courses or units you are tracking for assignment deadlines.</p>
        </div>

        <a href="{{ path('app_course_new') }}" class="btn btn-primary-yellow">Add Course</a>
    </div>

    <div class="card">
        {% if courses is empty %}
            <div class="empty-state centered">
                <p>No courses added yet.</p>
                <a href="{{ path('app_course_new') }}" class="btn">Create your first course</a>
            </div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>S/N</th>
                            <th>Course Name</th>
                            <th>Code</th>
                            <th>Date Added</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for course in courses %}
                        <tr>
                            <td class="serial-cell">{{ loop.index }}</td>
                            <td><strong>{{ course.name }}</strong></td>
                            <td>{{ course.code ?: 'N/A' }}</td>
                            <td>{{ course.createdAt ? course.createdAt|date('d M Y, h:i A') : '' }}</td>
                            <td>
                                <div class="actions">
                                    <a href="{{ path('app_course_show', {'id': course.id}) }}" class="action-btn action-view">View</a>
                                    <a href="{{ path('app_course_edit', {'id': course.id}) }}" class="action-btn action-edit">Edit</a>
                                    <button type="button"
                                            class="action-btn action-delete"
                                            onclick="document.getElementById('removeCourseModal{{ course.id }}').classList.add('active')">
                                        Remove
                                    </button>
                                </div>

                                <div class="modal-backdrop" id="removeCourseModal{{ course.id }}">
                                    <div class="modal-card modal-danger">
                                        <div class="modal-icon">!</div>
                                        <h3>Remove course?</h3>
                                        <p>
                                            This will remove <strong>{{ course.name }}</strong> from your account and hide its assignments.
                                            You cannot recover it from the app once removed.
                                        </p>

                                        <div class="modal-actions">
                                            <button type="button"
                                                    class="modal-cancel"
                                                    onclick="document.getElementById('removeCourseModal{{ course.id }}').classList.remove('active')">
                                                Cancel
                                            </button>
                                            <form method="post" action="{{ path('app_course_delete', {'id': course.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                                                <button class="modal-delete">Yes, remove</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
