{% extends 'base.html.twig' %}

{% block title %}Courses | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .page-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-header h1 {
        margin: 0;
        color: #111827;
        font-size: 30px;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #6b7280;
    }

    .btn {
        display: inline-block;
        background: #2563eb;
        color: #ffffff;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .btn:hover {
        background: #1d4ed8;
    }

    .btn-secondary {
        background: #374151;
    }

    .btn-secondary:hover {
        background: #1f2937;
    }

    .card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        padding: 24px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        color: #374151;
        font-size: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    td {
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
        color: #111827;
    }

    tr:last-child td {
        border-bottom: none;
    }

    .actions a {
        margin-right: 10px;
        color: #2563eb;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .empty-state {
        text-align: center;
        color: #6b7280;
        padding: 40px 20px;
    }

    @media (max-width: 700px) {
        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn {
            text-align: center;
        }

        table {
            font-size: 14px;
        }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>My Courses</h1>
            <p>Manage the courses or units you are tracking for assignment deadlines.</p>
        </div>

        <a href="{{ path('app_course_new') }}" class="btn">Add Course</a>
    </div>

    <div class="card">
        {% if courses is empty %}
            <div class="empty-state">
                <p>No courses added yet.</p>
                <a href="{{ path('app_course_new') }}" class="btn">Create your first course</a>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Course Name</th>
                        <th>Code</th>
                        <th>Date Added</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for course in courses %}
                    <tr>
                        <td>{{ course.name }}</td>
                        <td>{{ course.code ?: 'N/A' }}</td>
                        <td>{{ course.createdAt ? course.createdAt|date('d M Y, H:i') : '' }}</td>
                        <td class="actions">
                            <a href="{{ path('app_course_show', {'id': course.id}) }}">View</a>
                            <a href="{{ path('app_course_edit', {'id': course.id}) }}">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <div style="margin-top: 20px;">
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
{% endblock %}