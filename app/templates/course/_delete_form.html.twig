<style>
    .delete-form {
        margin: 0;
    }

    .delete-button {
        background: #dc2626;
        color: #ffffff;
        border: none;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 14px;
        cursor: pointer;
        box-shadow: 0 6px 14px rgba(220, 38, 38, 0.25);
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .delete-button:hover {
        background: #b91c1c;
        transform: translateY(-1px);
    }

    @media (max-width: 640px) {
        .delete-button {
            width: 100%;
        }
    }
</style>

<form method="post"
      action="{{ path('app_course_delete', {'id': course.id}) }}"
      class="delete-form"
      onsubmit="return confirm('Are you sure you want to delete this course? This action cannot be undone.');">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">

    <button class="delete-button">Delete Course</button>
</form>