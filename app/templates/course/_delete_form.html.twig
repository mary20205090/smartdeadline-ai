{% set modalId = 'removeCourseModal' ~ course.id %}

<button type="button"
        class="delete-trigger"
        onclick="document.getElementById('{{ modalId }}').classList.add('active')">
    Remove Course
</button>

<div class="modal-backdrop" id="{{ modalId }}">
    <div class="modal-card modal-danger">
        <div class="modal-icon">!</div>
        <h3>Remove course?</h3>

        <p>
            This will remove <strong>{{ course.name }}</strong> from your account and hide its assignments.
            You cannot recover it from the app once removed.
        </p>

        <div class="modal-actions">
            <button type="button"
                    class="modal-cancel"
                    onclick="document.getElementById('{{ modalId }}').classList.remove('active')">
                Cancel
            </button>

            <form method="post" action="{{ path('app_course_delete', {'id': course.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                <button class="modal-delete">Yes, remove</button>
            </form>
        </div>
    </div>
</div>
