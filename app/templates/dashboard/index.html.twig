{% extends 'base.html.twig' %}

{% block title %}Dashboard | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .dashboard-container {
        max-width: 1150px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .dashboard-header h1 {
        margin: 0;
        color: #111827;
        font-size: 32px;
    }

    .dashboard-header p {
        color: #6b7280;
        margin-top: 8px;
    }

    .logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dc2626;
        color: #ffffff;
        padding: 11px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
        box-shadow: 0 6px 14px rgba(220, 38, 38, 0.25);
        white-space: nowrap;
    }

    .logout-button:hover {
        background: #b91c1c;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 18px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #ffffff;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
        border-left: 4px solid transparent;
    }

    .stat-card h3 {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        text-transform: uppercase;
    }

    .stat-card p {
        margin: 12px 0 0;
        color: #111827;
        font-size: 30px;
        font-weight: bold;
    }

    .stat-warning {
        border-left-color: #f59e0b;
    }

    .stat-danger {
        border-left-color: #dc2626;
    }

    .stat-success {
        border-left-color: #16a34a;
    }

    .section-card {
        background: #ffffff;
        padding: 24px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
    }

    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .btn:hover {
        background: #1d4ed8;
    }

    .btn-secondary {
        background: #374151;
    }

    .btn-secondary:hover {
        background: #1f2937;
    }

    .section-title {
        margin-bottom: 18px;
    }

    .section-title h2 {
        margin: 0;
        color: #111827;
        font-size: 24px;
    }

    .section-title p {
        margin: 6px 0 0;
        color: #6b7280;
    }
    .section-title-flex {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }
    .empty-state {
        color: #6b7280;
        padding: 18px 0;
    }

    .assignment-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .assignment-list li {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .assignment-list li:last-child {
        border-bottom: none;
    }

    .assignment-title {
        font-weight: bold;
        color: #111827;
        margin-bottom: 5px;
    }

    .assignment-meta {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.5;
    }

    .assignment-actions {
        display: flex;
        align-items: center;
    }

    .small-btn {
        background: #eff6ff;
        color: #2563eb;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 13px;
        white-space: nowrap;
    }

    .small-btn:hover {
        background: #dbeafe;
    }

    .badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: bold;
        text-transform: capitalize;
        margin-left: 6px;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-in_progress {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-completed {
        background: #dcfce7;
        color: #166534;
    }

    .badge-overdue {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-due-soon {
        background: #ffedd5;
        color: #9a3412;
    }

    .badge-high {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-medium {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-low {
        background: #e5e7eb;
        color: #374151;
    }

    .notification-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .notification-list li {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .notification-list li:last-child {
        border-bottom: none;
    }

    .notification-title {
        font-weight: bold;
        color: #111827;
        margin-bottom: 5px;
    }

    .notification-message {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.5;
    }

    .notification-time {
        color: #9ca3af;
        font-size: 13px;
        margin-top: 6px;
    }

    .notification-status {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: bold;
        text-transform: capitalize;
    }
    @media (max-width: 700px) {
        .dashboard-topbar {
            flex-direction: column;
            align-items: stretch;
        }

        .logout-button,
        .btn {
            width: 100%;
        }

        .assignment-list li {
            flex-direction: column;
        }

        .assignment-actions {
            align-items: stretch;
        }

        .small-btn {
            text-align: center;
        }
    }
</style>

{% set overdueList = overdueAssignments|default([]) %}
{% set dueSoonList = dueSoonAssignments|default([]) %}
{% set upcomingList = upcomingAssignments|default([]) %}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="dashboard-topbar">
            <div>
                <h1>SMARTDEADLINE AI Dashboard</h1>
                <p>
                    Welcome, {{ app.user.fullName ?? app.user.userIdentifier }}.
                    Track your courses, assignments, and deadline risks here.
                </p>
            </div>

            <a href="{{ path('app_logout') }}" class="logout-button">Logout</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Courses</h3>
            <p>{{ totalCourses }}</p>
        </div>

        <div class="stat-card">
            <h3>Total Assignments</h3>
            <p>{{ totalAssignments }}</p>
        </div>

        <div class="stat-card">
            <h3>Pending</h3>
            <p>{{ pendingCount }}</p>
        </div>

        <div class="stat-card">
            <h3>In Progress</h3>
            <p>{{ inProgressCount }}</p>
        </div>

        <div class="stat-card stat-success">
            <h3>Completed</h3>
            <p>{{ completedCount }}</p>
        </div>

        <div class="stat-card stat-warning">
            <h3>Due Soon</h3>
            <p>{{ dueSoonCount|default(0) }}</p>
        </div>

        <div class="stat-card stat-danger">
            <h3>Overdue</h3>
            <p>{{ overdueCount }}</p>
        </div>
        <div class="stat-card stat-danger">
            <h3>High Risk</h3>
            <p>{{ highRiskCount }}</p>
        </div>

        <div class="stat-card stat-warning">
            <h3>Medium Risk</h3>
            <p>{{ mediumRiskCount }}</p>
        </div>

        <div class="stat-card stat-success">
            <h3>Low Risk</h3>
            <p>{{ lowRiskCount }}</p>
        </div>
    </div>

    <div class="section-card">
        <div class="quick-actions">
            <a href="{{ path('app_course_new') }}" class="btn">Add Course</a>
            <a href="{{ path('app_course_index') }}" class="btn btn-secondary">View Courses</a>
            <a href="{{ path('app_assignment_new') }}" class="btn">Add Assignment</a>
            <a href="{{ path('app_assignment_index') }}" class="btn btn-secondary">View Assignments</a>
            <a href="{{ path('app_notification_index') }}" class="btn btn-secondary">
                Notifications
                {% if unreadNotificationCount|default(0) > 0 %}
                    ({{ unreadNotificationCount }})
                {% endif %}
            </a>
        </div>
    </div>

    <div class="section-card">
        <div class="section-title section-title-flex">
        <div>
        
        <div class="section-card">
            <div class="section-title">
                <h2>High Risk Assignments</h2>
                <p>Assignments predicted to have a high risk of missing the deadline.</p>
            </div>

            {% if highRiskAssignments is empty %}
                <div class="empty-state">
                    No high-risk assignments detected.
                </div>
            {% else %}
                <ul class="assignment-list">
                    {% for assignment in highRiskAssignments %}
                        {% set prediction = predictionsByAssignmentId[assignment.id]|default(null) %}

                        <li>
                            <div>
                                <div class="assignment-title">
                                    {{ assignment.title }}
                                    {% if prediction %}
                                        <span class="badge badge-{{ prediction.riskLevel }}">
                                            {{ prediction.riskLevel }}
                                        </span>
                                    {% endif %}
                                </div>

                                <div class="assignment-meta">
                                    {{ assignment.course.name }}
                                    {% if assignment.course.code %}
                                        ({{ assignment.course.code }})
                                    {% endif %}
                                    <br>
                                    Deadline: {{ assignment.deadline|date('d M Y, H:i') }}
                                    {% if prediction and prediction.probability is not null %}
                                        <br>
                                        Confidence: {{ (prediction.probability * 100)|round }}%
                                    {% endif %}
                                </div>
                            </div>

                            <div class="assignment-actions">
                                <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">
                                    View
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
            <h2>Recent Notifications</h2>
            <p>System alerts for due soon and overdue assignments.</p>
        </div>

        <a href="{{ path('app_notification_index') }}" class="small-btn">View All</a>
    </div>

        {% if recentNotifications is empty %}
            <div class="empty-state">
                No notifications yet. Deadline alerts will appear here once assignments are due soon or overdue.
            </div>
        {% else %}
            <ul class="notification-list">
                {% for notification in recentNotifications %}
                    <li>
                        <div>
                            <div class="notification-title">{{ notification.title }}</div>
                            <div class="notification-message">{{ notification.message }}</div>
                            <div class="notification-time">
                                {{ notification.createdAt ? notification.createdAt|date('d M Y, H:i') : '' }}
                            </div>
                        </div>

                        <div>
                            <span class="notification-status">{{ notification.status }}</span>

                            {% if notification.assignment %}
                                <br><br>
                                <a href="{{ path('app_assignment_show', {'id': notification.assignment.id}) }}" class="small-btn">
                                    View
                                </a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="section-card">
        <div class="section-title">
            <h2>Overdue Assignments</h2>
            <p>Assignments whose deadlines have passed and are not completed.</p>
        </div>

        {% if overdueList is empty %}
            <div class="empty-state">
                No overdue assignments. Good job staying on track.
            </div>
        {% else %}
            <ul class="assignment-list">
                {% for assignment in overdueList %}
                    <li>
                        <div>
                            <div class="assignment-title">{{ assignment.title }}</div>
                            <div class="assignment-meta">
                                {{ assignment.course.name }}
                                {% if assignment.course.code %}
                                    ({{ assignment.course.code }})
                                {% endif %}
                                <br>
                                Deadline: {{ assignment.deadline|date('d M Y, H:i') }}

                                <span class="badge badge-overdue">Overdue</span>

                                <span class="badge badge-{{ assignment.status }}">
                                    {{ assignment.status|replace({'_': ' '}) }}
                                </span>

                                {% if assignment.priority %}
                                    <span class="badge badge-{{ assignment.priority }}">
                                        {{ assignment.priority }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="assignment-actions">
                            <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">
                                View
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="section-card">
        <div class="section-title">
            <h2>Due Soon</h2>
            <p>Assignments due within the next 3 days.</p>
        </div>

        {% if dueSoonList is empty %}
            <div class="empty-state">
                No assignments due soon.
            </div>
        {% else %}
            <ul class="assignment-list">
                {% for assignment in dueSoonList %}
                    <li>
                        <div>
                            <div class="assignment-title">{{ assignment.title }}</div>
                            <div class="assignment-meta">
                                {{ assignment.course.name }}
                                {% if assignment.course.code %}
                                    ({{ assignment.course.code }})
                                {% endif %}
                                <br>
                                Due: {{ assignment.deadline|date('d M Y, H:i') }}

                                <span class="badge badge-due-soon">Due soon</span>

                                <span class="badge badge-{{ assignment.status }}">
                                    {{ assignment.status|replace({'_': ' '}) }}
                                </span>

                                {% if assignment.priority %}
                                    <span class="badge badge-{{ assignment.priority }}">
                                        {{ assignment.priority }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="assignment-actions">
                            <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">
                                View
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div class="section-card">
        <div class="section-title">
            <h2>Upcoming Assignments</h2>
            <p>Your nearest pending or in-progress deadlines.</p>
        </div>

        {% if upcomingList is empty %}
            <div class="empty-state">
                No upcoming assignments yet. Once you add courses and assignments, they will appear here.
            </div>
        {% else %}
            <ul class="assignment-list">
                {% for assignment in upcomingList %}
                    <li>
                        <div>
                            <div class="assignment-title">{{ assignment.title }}</div>
                            <div class="assignment-meta">
                                {{ assignment.course.name }}
                                {% if assignment.course.code %}
                                    ({{ assignment.course.code }})
                                {% endif %}
                                <br>
                                Due: {{ assignment.deadline|date('d M Y, H:i') }}

                                <span class="badge badge-{{ assignment.status }}">
                                    {{ assignment.status|replace({'_': ' '}) }}
                                </span>

                                {% if assignment.priority %}
                                    <span class="badge badge-{{ assignment.priority }}">
                                        {{ assignment.priority }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="assignment-actions">
                            <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">
                                View
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}