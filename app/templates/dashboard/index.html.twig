{% extends 'base.html.twig' %}

{% block title %}Dashboard | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .dashboard-container {
        max-width: 1150px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .dashboard-header h1 {
        margin: 0;
        color: #111827;
        font-size: 32px;
    }

    .dashboard-header p {
        color: #6b7280;
        margin-top: 8px;
    }

    .logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dc2626;
        color: #ffffff;
        padding: 11px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
        box-shadow: 0 6px 14px rgba(220, 38, 38, 0.25);
        white-space: nowrap;
    }

    .logout-button:hover {
        background: #b91c1c;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 18px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #ffffff;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .stat-card h3 {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        text-transform: uppercase;
    }

    .stat-card p {
        margin: 12px 0 0;
        color: #111827;
        font-size: 30px;
        font-weight: bold;
    }

    .section-card {
        background: #ffffff;
        padding: 24px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .btn:hover {
        background: #1d4ed8;
    }

    .btn-secondary {
        background: #374151;
    }

    .btn-secondary:hover {
        background: #1f2937;
    }

    .section-title {
        border-top: 1px solid #e5e7eb;
        padding-top: 24px;
        margin-top: 10px;
        margin-bottom: 18px;
    }

    .section-title h2 {
        margin: 0;
        color: #111827;
        font-size: 26px;
    }

    .section-title p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .empty-state {
        color: #6b7280;
        padding: 24px 0;
    }

    .assignment-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .assignment-list li {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .assignment-list li:last-child {
        border-bottom: none;
    }

    .assignment-title {
        font-weight: bold;
        color: #111827;
        margin-bottom: 5px;
    }

    .assignment-meta {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.5;
    }

    .assignment-actions {
        display: flex;
        align-items: center;
    }

    .small-btn {
        background: #eff6ff;
        color: #2563eb;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 13px;
        white-space: nowrap;
    }

    .small-btn:hover {
        background: #dbeafe;
    }

    .badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: bold;
        text-transform: capitalize;
        margin-left: 6px;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-in_progress {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-completed {
        background: #dcfce7;
        color: #166534;
    }

    .badge-high {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-medium {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-low {
        background: #e5e7eb;
        color: #374151;
    }

    @media (max-width: 700px) {
        .dashboard-topbar {
            flex-direction: column;
            align-items: stretch;
        }

        .logout-button,
        .btn {
            width: 100%;
        }

        .assignment-list li {
            flex-direction: column;
        }

        .assignment-actions {
            align-items: stretch;
        }

        .small-btn {
            text-align: center;
        }
    }
</style>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="dashboard-topbar">
            <div>
                <h1>SMARTDEADLINE AI Dashboard</h1>
                <p>
                    Welcome, {{ app.user.fullName ?? app.user.userIdentifier }}.
                    Track your courses, assignments, and deadline risks here.
                </p>
            </div>

            <a href="{{ path('app_logout') }}" class="logout-button">Logout</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Courses</h3>
            <p>{{ totalCourses }}</p>
        </div>

        <div class="stat-card">
            <h3>Total Assignments</h3>
            <p>{{ totalAssignments }}</p>
        </div>

        <div class="stat-card">
            <h3>Pending</h3>
            <p>{{ pendingCount }}</p>
        </div>

        <div class="stat-card">
            <h3>In Progress</h3>
            <p>{{ inProgressCount }}</p>
        </div>

        <div class="stat-card">
            <h3>Completed</h3>
            <p>{{ completedCount }}</p>
        </div>

        <div class="stat-card">
            <h3>Overdue</h3>
            <p>{{ overdueCount }}</p>
        </div>
    </div>

    <div class="section-card">
        <div class="quick-actions">
            <a href="{{ path('app_course_new') }}" class="btn">Add Course</a>
            <a href="{{ path('app_course_index') }}" class="btn btn-secondary">View Courses</a>
            <a href="{{ path('app_assignment_new') }}" class="btn">Add Assignment</a>
            <a href="{{ path('app_assignment_index') }}" class="btn btn-secondary">View Assignments</a>
        </div>

        <div class="section-title">
            <h2>Upcoming Assignments</h2>
            <p>Your nearest pending or in-progress deadlines.</p>
        </div>

        {% if upcomingAssignments is empty %}
            <div class="empty-state">
                No upcoming assignments yet. Once you add courses and assignments, they will appear here.
            </div>
        {% else %}
            <ul class="assignment-list">
                {% for assignment in upcomingAssignments %}
                    <li>
                        <div>
                            <div class="assignment-title">{{ assignment.title }}</div>
                            <div class="assignment-meta">
                                {{ assignment.course.name }}
                                {% if assignment.course.code %}
                                    ({{ assignment.course.code }})
                                {% endif %}
                                <br>
                                Due: {{ assignment.deadline|date('d M Y, H:i') }}

                                <span class="badge badge-{{ assignment.status }}">
                                    {{ assignment.status|replace({'_': ' '}) }}
                                </span>

                                {% if assignment.priority %}
                                    <span class="badge badge-{{ assignment.priority }}">
                                        {{ assignment.priority }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="assignment-actions">
                            <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">
                                View
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}