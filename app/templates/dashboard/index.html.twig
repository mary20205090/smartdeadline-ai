{% extends 'base.html.twig' %}

{% block title %}Dashboard | SMARTDEADLINE AI{% endblock %}

{% block body %}
{% set overdueList = overdueAssignments|default([]) %}
{% set dueSoonList = dueSoonAssignments|default([]) %}
{% set upcomingList = upcomingAssignments|default([]) %}

<style>
    .dashboard-page {
        --hero-min: 168px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    .hero-card {
        position: relative;
        overflow: hidden;
        min-height: var(--hero-min);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        padding: 24px;
        background: linear-gradient(135deg, var(--brand-blue-dark), var(--brand-blue) 58%, #0ea5e9);
        color: #ffffff;
    }

    .hero-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 6px;
        background: var(--brand-yellow);
    }

    .hero-copy {
        position: relative;
        max-width: 720px;
    }

    .eyebrow {
        margin: 0 0 8px;
        color: var(--brand-yellow);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .hero-copy h2 {
        margin: 0;
        color: #ffffff;
        font-size: 28px;
        line-height: 1.15;
    }

    .hero-copy p {
        margin: 10px 0 0;
        color: #eaf3ff;
        font-size: 14px;
        line-height: 1.55;
    }

    .hero-badge {
        position: relative;
        min-width: 122px;
        padding: 15px;
        border-radius: var(--radius);
        border: 1px solid rgba(255, 255, 255, 0.26);
        background: rgba(255, 255, 255, 0.14);
        color: #ffffff;
        font-weight: 800;
        text-align: center;
    }

    .hero-badge span {
        display: block;
        margin-top: 4px;
        color: #dbeafe;
        font-size: 12px;
        font-weight: 700;
    }

    .focus-grid,
    .metric-grid {
        display: grid;
        gap: 10px;
    }

    .focus-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .focus-card {
        min-height: var(--hero-min);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: none;
    }

    .focus-card span,
    .metric-card span {
        color: var(--muted);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .focus-card strong {
        color: var(--text);
        font-size: 30px;
        line-height: 1;
    }

    .focus-card.high {
        border-top: 4px solid var(--danger);
    }

    .focus-card.soon {
        border-top: 4px solid var(--brand-yellow);
    }

    .focus-card.alerts {
        border-top: 4px solid var(--brand-blue);
    }

    .action-card {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
        padding: 13px;
        box-shadow: none;
    }

    .metric-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .metric-card {
        min-height: 92px;
        padding: 16px;
        box-shadow: none;
    }

    .metric-card strong {
        display: block;
        margin-top: 10px;
        color: var(--text);
        font-size: 24px;
    }

    .metric-card.accent {
        border-top: 3px solid var(--brand-yellow);
    }

    .work-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.75fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    .deadline-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .panel-card {
        padding: 20px;
    }

    .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 19px;
    }

    .panel-header p {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.4;
    }

    .dash-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .dash-list li {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
    }

    .dash-list li:last-child {
        border-bottom: 0;
    }

    .item-title {
        color: var(--text);
        font-size: 15px;
        font-weight: 800;
        line-height: 1.35;
    }

    .item-meta,
    .item-message {
        margin-top: 4px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
    }

    .item-time {
        display: block;
        margin-top: 6px;
        color: #98a2b3;
        font-size: 12px;
    }

    .item-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    @media (max-width: 1100px) {
        .hero-grid,
        .work-grid,
        .deadline-grid {
            grid-template-columns: 1fr;
        }

        .focus-card {
            min-height: 118px;
        }

        .metric-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 700px) {
        .hero-card,
        .panel-header,
        .dash-list li {
            flex-direction: column;
            align-items: stretch;
        }

        .focus-grid,
        .metric-grid {
            grid-template-columns: 1fr;
        }

        .item-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="dashboard-page">
    <section class="hero-grid">
        <div class="hero-card">
            <div class="hero-copy">
                <p class="eyebrow">Today overview</p>
                <h2>Welcome, {{ app.user.fullName ?? app.user.userIdentifier }}</h2>
                <p>Review your course load, urgent deadlines, and AI risk signals before anything slips.</p>
            </div>
            <div class="hero-badge">
                {{ totalAssignments }}
                <span>Total assignments</span>
            </div>
        </div>

        <div class="focus-grid">
            <div class="focus-card high"><span>High risk</span><strong>{{ highRiskCount }}</strong></div>
            <div class="focus-card soon"><span>Due soon</span><strong>{{ dueSoonCount|default(0) }}</strong></div>
            <div class="focus-card alerts"><span>Unread alerts</span><strong>{{ unreadNotificationCount|default(0) }}</strong></div>
        </div>
    </section>

    <section class="action-card dashboard-action-card">
        <div class="dashboard-action-group">
            <a href="{{ path('app_course_new') }}" class="btn btn-primary dashboard-action-main">Add Course</a>
            <a href="{{ path('app_course_index') }}" class="btn btn-secondary dashboard-action-view">View Courses</a>
            <a href="{{ path('app_course_index', {'mode': 'remove'}) }}" class="btn btn-danger-soft">Remove Course</a>
        </div>

        <div class="dashboard-action-group">
            <a href="{{ path('app_assignment_new') }}" class="btn btn-primary-yellow dashboard-action-create">Add Assignment</a>
            <a href="{{ path('app_assignment_index') }}" class="btn btn-secondary dashboard-action-view">View Assignments</a>
            <a href="{{ path('app_assignment_index', {'mode': 'remove'}) }}" class="btn btn-danger-soft">Remove Assignment</a>
        </div>

        <div class="dashboard-action-group">
            <a href="{{ path('app_notification_index', {'status': 'unread'}) }}" class="btn btn-secondary dashboard-action-alerts">
                Notifications{% if unreadNotificationCount|default(0) > 0 %} ({{ unreadNotificationCount }}){% endif %}
            </a>
        </div>
    </section>

    <section class="metric-grid">
        <a href="{{ path('app_course_index') }}" class="metric-card accent"><span>Total Courses</span><strong>{{ totalCourses }}</strong></a>
        <div class="metric-card accent"><span>Pending</span><strong>{{ pendingCount }}</strong></div>
        <div class="metric-card"><span>In Progress</span><strong>{{ inProgressCount }}</strong></div>
        <div class="metric-card"><span>Completed</span><strong>{{ completedCount }}</strong></div>
        <div class="metric-card"><span>Overdue</span><strong>{{ overdueCount }}</strong></div>
        <div class="metric-card"><span>Medium Risk</span><strong>{{ mediumRiskCount }}</strong></div>
        <div class="metric-card"><span>Low Risk</span><strong>{{ lowRiskCount }}</strong></div>
        <a href="{{ path('app_assignment_index') }}" class="metric-card"><span>Total Work</span><strong>{{ totalAssignments }}</strong></a>
    </section>

    <section class="work-grid">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3>Priority Queue</h3>
                    <p>High-risk assignments appear first.</p>
                </div>
                <a href="{{ path('app_assignment_index') }}" class="small-btn">All Assignments</a>
            </div>

            {% if highRiskAssignments is empty %}
                <div class="empty-state">No high-risk assignments detected.</div>
            {% else %}
                <ul class="dash-list">
                    {% for assignment in highRiskAssignments %}
                        {% set prediction = predictionsByAssignmentId[assignment.id]|default(null) %}
                        <li>
                            <div>
                                <div class="item-title">{{ assignment.title }}</div>
                                <div class="item-meta">
                                    {{ assignment.course.name }}{% if assignment.course.code %} ({{ assignment.course.code }}){% endif %}
                                    · {{ assignment.deadline|date('d M Y, h:i A') }}
                                    {% if prediction and prediction.probability is not null %}
                                        · {{ (prediction.probability * 100)|round }}% confidence
                                    {% endif %}
                                </div>
                            </div>
                            <div class="item-actions">
                                {% if prediction %}
                                    <span class="badge badge-{{ prediction.riskLevel }}">{{ prediction.riskLevel }}</span>
                                {% endif %}
                                <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">View</a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3>Unread Notifications</h3>
                    <p>Only alerts that still need attention appear here.</p>
                </div>
                <a href="{{ path('app_notification_index', {'status': 'unread'}) }}" class="small-btn">View Unread</a>
            </div>

            {% if recentNotifications is empty %}
                <div class="empty-state">No unread notifications.</div>
            {% else %}
                <ul class="dash-list">
                    {% for notification in recentNotifications %}
                        <li>
                            <div>
                                <div class="item-title">{{ notification.title }}</div>
                                <div class="item-message">{{ notification.message }}</div>
                                {% if notification.assignment %}
                                    <div class="item-meta">
                                        Course:
                                        {{ notification.assignment.course.name }}{% if notification.assignment.course.code %} ({{ notification.assignment.course.code }}){% endif %}
                                    </div>
                                {% endif %}
                                <span class="item-time">{{ notification.createdAt ? notification.createdAt|date('d M Y, h:i A') : '' }}</span>
                            </div>
                            <span class="badge status-{{ notification.status }}">{{ notification.status }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>

    <section class="deadline-grid">
        {% for title, list in {'Overdue': overdueList, 'Due Soon': dueSoonList, 'Upcoming': upcomingList} %}
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <h3>{{ title }}</h3>
                        <p>
                            {% if title == 'Overdue' %}
                                Past deadlines still open.
                            {% elseif title == 'Due Soon' %}
                                Next 3 days.
                            {% else %}
                                Nearest active work.
                            {% endif %}
                        </p>
                    </div>
                </div>

                {% if list is empty %}
                    <div class="empty-state">No {{ title|lower }} assignments.</div>
                {% else %}
                    <ul class="dash-list">
                        {% for assignment in list %}
                            <li>
                                <div>
                                    <div class="item-title">{{ assignment.title }}</div>
                                    <div class="item-meta">{{ assignment.course.name }} · {{ assignment.deadline|date('d M Y, h:i A') }}</div>
                                </div>
                                <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="small-btn">View</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endfor %}
    </section>

</div>
{% endblock %}
