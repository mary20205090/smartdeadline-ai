{% extends 'base.html.twig' %}

{% block title %}Dashboard | SMARTDEADLINE AI{% endblock %}

{% block body %}
<style>
    body {
        background: #f4f7fb;
        font-family: Arial, sans-serif;
    }

    .dashboard-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin: 0;
        color: #1f2937;
        font-size: 32px;
    }

    .dashboard-header p {
        color: #6b7280;
        margin-top: 8px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #ffffff;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .stat-card h3 {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        text-transform: uppercase;
    }

    .stat-card p {
        margin: 12px 0 0;
        color: #111827;
        font-size: 32px;
        font-weight: bold;
    }

    .section-card {
        background: #ffffff;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

    .section-card h2 {
        margin-top: 0;
        color: #1f2937;
    }

    .empty-state {
        color: #6b7280;
        padding: 20px 0;
    }

    .assignment-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .assignment-list li {
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .assignment-list li:last-child {
        border-bottom: none;
    }

    .assignment-title {
        font-weight: bold;
        color: #111827;
    }

    .assignment-meta {
        color: #6b7280;
        font-size: 14px;
        margin-top: 4px;
    }

    .actions {
        margin-top: 25px;
    }

    .btn {
        display: inline-block;
        background: #2563eb;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        margin-right: 10px;
    }

    .btn-secondary {
        background: #374151;
    }
</style>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>SMARTDEADLINE AI Dashboard</h1>
        <p>Welcome, {{ app.user.fullName ?? app.user.userIdentifier }}. Track your courses, assignments, and deadline risks here.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Courses</h3>
            <p>{{ totalCourses }}</p>
        </div>

        <div class="stat-card">
            <h3>Total Assignments</h3>
            <p>{{ totalAssignments }}</p>
        </div>

        <div class="stat-card">
            <h3>Overdue Assignments</h3>
            <p>{{ overdueCount }}</p>
        </div>

        <div class="stat-card">
            <h3>Completed</h3>
            <p>{{ completedCount }}</p>
        </div>
    </div>

    <div class="section-card">
        <h2>Upcoming Assignments</h2>

        {% if upcomingAssignments is empty %}
            <div class="empty-state">
                No upcoming assignments yet. Once you add courses and assignments, they will appear here.
            </div>
        {% else %}
            <ul class="assignment-list">
                {% for assignment in upcomingAssignments %}
                    <li>
                        <div class="assignment-title">{{ assignment.title }}</div>
                        <div class="assignment-meta">
                            Due: {{ assignment.deadline|date('d M Y, H:i') }}
                            | Status: {{ assignment.status }}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="actions">
            <a href="#" class="btn">Add Course</a>
            <a href="#" class="btn btn-secondary">Add Assignment</a>
        </div>
    </div>
</div>
{% endblock %}